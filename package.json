{
  "name": "google-sheets-exporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "build": "vite build --configLoader native",
    "prebuild": "npm run schemas:check",
    "schemas:generate": "node scripts/generate-validators.mjs",
    "schemas:check": "node scripts/generate-validators.mjs --check",
    "test:e2e": "node tests/e2e/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "csv-parse": "5.6.0",
    "fast-xml-parser": "5.11.2",
    "playwright-core": "1.52.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "fflate": "0.8.3"
  }
}
