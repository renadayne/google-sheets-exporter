{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:google-sheets-exporter:export.schema.json",
  "title": "JsonExportDocument",
  "description": "Complete JSON export document envelope for Google Sheets exports (Architecture G / domain.ts).",
  "type": "object",
  "allOf": [
    { "$ref": "urn:google-sheets-exporter:report.schema.json#/$defs/baseReport" },
    {
      "type": "object",
      "properties": {
        "selectedScopes": { "type": "array", "minItems": 1 },
        "sheetOrder": { "type": "array", "minItems": 1, "uniqueItems": true },
        "nameMappings": { "type": "array", "minItems": 1 },
        "export": {
          "type": "object",
          "properties": {
            "complete": { "const": true },
            "format": { "const": "json" },
            "consistency": {
              "enum": [
                "not_atomic_no_change_detected",
                "not_atomic_unverified"
              ]
            }
          },
          "required": ["complete", "format", "consistency"]
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/exportSheet" }
        }
      },
      "required": ["sheets"]
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "export": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["raw", "formatted"] }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "formulaText": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "export": {
            "type": "object",
            "properties": {
              "mode": { "const": "formatted" }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cells": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": { "const": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "cellErrorValue": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "stringCell": {
      "type": "object",
      "properties": {
        "r": { "type": "integer", "minimum": 0 },
        "c": { "type": "integer", "minimum": 0 },
        "kind": { "const": "string" },
        "value": { "type": "string" },
        "formulaText": { "type": "string" },
        "numberFormatType": { "type": "string" }
      },
      "required": ["r", "c", "kind", "value"],
      "additionalProperties": false
    },
    "numberCell": {
      "type": "object",
      "properties": {
        "r": { "type": "integer", "minimum": 0 },
        "c": { "type": "integer", "minimum": 0 },
        "kind": { "const": "number" },
        "value": { "type": "number" },
        "numberFormatType": { "type": "string" }
      },
      "required": ["r", "c", "kind", "value"],
      "additionalProperties": false
    },
    "booleanCell": {
      "type": "object",
      "properties": {
        "r": { "type": "integer", "minimum": 0 },
        "c": { "type": "integer", "minimum": 0 },
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" },
        "numberFormatType": { "type": "string" }
      },
      "required": ["r", "c", "kind", "value"],
      "additionalProperties": false
    },
    "errorCell": {
      "type": "object",
      "properties": {
        "r": { "type": "integer", "minimum": 0 },
        "c": { "type": "integer", "minimum": 0 },
        "kind": { "const": "error" },
        "value": { "$ref": "#/$defs/cellErrorValue" },
        "numberFormatType": { "type": "string" }
      },
      "required": ["r", "c", "kind", "value"],
      "additionalProperties": false
    },
    "cell": {
      "oneOf": [
        { "$ref": "#/$defs/stringCell" },
        { "$ref": "#/$defs/numberCell" },
        { "$ref": "#/$defs/booleanCell" },
        { "$ref": "#/$defs/errorCell" }
      ]
    },
    "sheetVisibility": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["include_all", "api_visible"] },
        "excludedRows": {
          "type": "array",
          "items": { "$ref": "urn:google-sheets-exporter:report.schema.json#/$defs/dimensionInterval" }
        },
        "excludedColumns": {
          "type": "array",
          "items": { "$ref": "urn:google-sheets-exporter:report.schema.json#/$defs/dimensionInterval" }
        }
      },
      "required": ["mode", "excludedRows", "excludedColumns"],
      "additionalProperties": false
    },
    "exportSheet": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "scope": { "$ref": "urn:google-sheets-exporter:report.schema.json#/$defs/rect" },
        "visibility": { "$ref": "#/$defs/sheetVisibility" },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        }
      },
      "required": ["id", "title", "index", "scope", "visibility", "cells"],
      "additionalProperties": false
    }
  }
}
